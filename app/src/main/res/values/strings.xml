    <!-- Builder C: For Parents -->
    <string name="forparents_title">For Parents</string>
    <string name="forparents_data_title">What we collect</string>
    <string name="forparents_data_body">Almost nothing. Your child picks a base name, catches cartoon buddies, and earns coins. Everything lives on this device only. There is no account, no login, and no analytics in this version. We never collect location, contacts, photos, or device identifiers. The advertising ID is stripped from the app.</string>
    <string name="forparents_ads_title">Ads</string>
    <string name="forparents_ads_body">There is exactly one ad in the whole game: a Free Coins button in the Shop that shows a short rewarded video. Ads are G-rated, non-personalized, skippable within 5 seconds, start muted, and never appear on launch. You can remove ads forever with a one-time $2.99 purchase, behind the grown-up check.</string>
    <string name="forparents_purchases_title">Purchases</string>
    <string name="forparents_purchases_body">Remove Ads ($2.99, one-time) and three cosmetic hats ($0.99 each, visual only). Every purchase needs the grown-up check: hold for 3 seconds, then answer a math question. Nothing random is ever sold. No loot boxes.</string>
    <string name="forparents_friends_title">Friends and chat</string>
    <string name="forparents_friends_body">Friends pair in person with a 6-letter code, behind the grown-up check. Kids can only send 12 preset phrases and 10 emotes. No free text, no voice, no stranger contact. Raids happen over nearby Bluetooth and WiFi only. No internet matchmaking.</string>
    <string name="forparents_data_delete_title">Delete data</string>
    <string name="forparents_data_delete_body">The Delete All Data button in Settings wipes buddies, coins, tickets, settings, and the imported poster from this device. No account means nothing to cancel.</string>
    <string name="forparents_contact_title">Contact</string>
    <string name="forparents_contact_body">Questions about the game or this policy? Reach us on GitHub.</string>
    <string name="forparents_contact_button">Open GitHub</string>

